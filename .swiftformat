# Project-local SwiftFormat config, so `xc format` gives the same result on any machine.
# The Swift version comes from .swift-version.

--disable unusedArguments, wrapMultilineStatementBraces, hoistPatternLet, preferKeyPath, extensionAccessControl, modifierOrder, andOperator, initCoderUnavailable, redundantReturn
--trailing-commas never
--ranges no-space
--max-width 120
--wrap-arguments before-first
--wrap-parameters before-first
--wrap-collections before-first
--trim-whitespace nonblank-lines
--self init-only
--ifdef no-indent
--test-case-name-format standard-identifiers

# .build holds fetched dependencies.
--exclude .build
